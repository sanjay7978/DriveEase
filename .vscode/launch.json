{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Build database (reset sample data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/setup_database.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal"
    },
    {
      "name": "2. Build database + run 28 test cases",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/setup_database.py",
      "args": ["--tests"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal"
    },
    {
      "name": "3. Start website (http://127.0.0.1:5050)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/app.py",
      "cwd": "${workspaceFolder}/app",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "env": { "FLASK_DEBUG": "0" }
    }
  ]
}
